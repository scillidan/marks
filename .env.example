# Supports environment variables (Windows: %USERPROFILE%, Linux: $HOME).

# Paths to exclude from both PDF builds and the generated manifest.
# Path prefixes relative to the repo root, separated by spaces and/or semicolons.
# Adding "copy/" here prevents the copy/ pipeline from being built as part of
# `_site/gen.sh` and keeps Copy entries out of manifest.json.
GEN_EXCLUDE="post/laws-of-software-engineering/;copy/"

# BYYA-site upstream sources (content.zh/docs)
#
# Used by:
#   - `uv run scripts/sync_byya_lyra_md.py` (syncs lyra .md sources)
#   - `just nineveh-md <subdir>` / `uv run scripts/gen_byya_nineveh_md.py`
#     (initial generation of nineveh .typ files; _site/gen.sh compiles
#     already-committed .typ files and does not need this variable)
#
# CI clones BYYA-site automatically. For local builds, pass --source or set:
BYYA_SITE_DOCS=${USERPROFILE}/path/to

# image-collect/
#
# When not set, falls back to image-collect/assets/ within the project.
# NOTE: image-collect/assets/ is gitignored. For cloud builds, either commit the
# assets or set IMAGE_COLLECT_SOURCE to a path that exists on the runner.
IMAGE_COLLECT_SOURCE=${USERPROFILE}/path/to

# copy/
#
# Source directory for .md files that should be rendered with the copy/
# pipeline but kept outside the repo (e.g. for copyright reasons). When a
# path passed to `just copy <file>` is not found in the working tree, the
# script falls back to COPY_SOURCE/<file>.
COPY_SOURCE=${USERPROFILE}/Share/temps/mds

# post/
#
# When not set, falls back to post/assets/ within the project.
POST_SOURCE=${USERPROFILE}/Local/Asset/cdn_image_post
# Upscaling model for small images. Optional; when unset, originals are copied.
UPSCAYL_MODEL=${USERPROFILE}/path/to/ncnn/models